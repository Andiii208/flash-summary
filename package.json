{
  "name": "seu-summary",
  "version": "0.7.7",
  "description": "Flash Summary - turn SEU Kedacom course recordings and Bilibili videos into structured study notes (Windows)",
  "main": "./out/main/index.cjs",
  "author": "Flash Summary contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andiii208/seu-summary.git"
  },
  "bugs": {
    "url": "https://github.com/Andiii208/seu-summary/issues"
  },
  "homepage": "https://github.com/Andiii208/seu-summary#readme",
  "private": true,
  "type": "module",
  "build": {
    "appId": "edu.seu.summary",
    "productName": "Flash Summary",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json",
      "!node_modules/ffmpeg-static/**",
      "!node_modules/ffprobe-static/**",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/build/**",
      "!node_modules/better-sqlite3/prebuilds/darwin-arm64.node",
      "!node_modules/better-sqlite3/prebuilds/darwin-x64.node",
      "!node_modules/better-sqlite3/prebuilds/linux-arm64.node",
      "!node_modules/better-sqlite3/prebuilds/linux-x64.node",
      "!node_modules/better-sqlite3/prebuilds/linuxmusl-arm64.node",
      "!node_modules/better-sqlite3/prebuilds/linuxmusl-x64.node",
      "!node_modules/better-sqlite3/prebuilds/win32-arm64.node"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe",
        "to": "ffmpeg/ffprobe.exe"
      },
      {
        "from": "DISCLAIMER.md",
        "to": "legal/DISCLAIMER.md"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "legal/THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "LICENSES",
        "to": "legal/LICENSES"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "build/installer-license.txt"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && node scripts/smoke-cdp.mjs",
    "verify:asar": "node scripts/verify-asar.mjs"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@eslint/js": "^9.30.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.16.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "eslint": "^9.30.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "happy-dom": "^20.12.0",
    "katex": "^0.18.7",
    "lucide-preact": "^1.40.0",
    "lxgw-wenkai-screen-webfont": "^1.7.0",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "preact": "^10.29.8",
    "qrcode": "^1.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4",
    "zod": "^4.5.4"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "jpeg-js": "^0.4.4"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "electron@44.0.0": true
  }
}
