{
  "name": "seu-summary",
  "version": "0.3.0-m1",
  "description": "SEU Summary - turn SEU Kedacom course recordings into structured study notes (Windows MVP)",
  "main": "./out/main/index.cjs",
  "author": "SEU Summary contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andiii208/seu-summary.git"
  },
  "bugs": {
    "url": "https://github.com/Andiii208/seu-summary/issues"
  },
  "homepage": "https://github.com/Andiii208/seu-summary#readme",
  "private": true,
  "type": "module",
  "build": {
    "appId": "edu.seu.summary",
    "productName": "SEU Summary",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe",
        "to": "ffmpeg/ffprobe.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && node scripts/smoke-cdp.mjs",
    "verify:asar": "node scripts/verify-asar.mjs"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@eslint/js": "^9.30.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.16.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "eslint": "^9.30.0",
    "happy-dom": "^20.12.0",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "jpeg-js": "^0.4.4",
    "preact": "^10.29.8",
    "zod": "^4.5.4"
  }
}
